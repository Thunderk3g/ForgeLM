  {
    "info": {
      "name": "LLMForge Fine-tuning API",
      "description": "Simplified fine-tuning platform for LLM models",
      "version": "1.0.0",
      "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
      {
        "key": "baseUrl",
        "value": "http://localhost:8000",
        "type": "string",
        "description": "Base URL for the LLMForge API"
      }
    ],
    "item": [
      {
        "name": "Health Check",
        "request": {
          "method": "GET",
          "header": [],
          "url": {
            "raw": "{{baseUrl}}/health",
            "host": ["{{baseUrl}}"],
            "path": ["health"]
          },
          "description": "Health check endpoint to verify API status"
        },
        "response": []
      },
      {
        "name": "API Info",
        "request": {
          "method": "GET",
          "header": [],
          "url": {
            "raw": "{{baseUrl}}/",
            "host": ["{{baseUrl}}"],
            "path": [""]
          },
          "description": "Root endpoint with API information and available endpoints"
        },
        "response": []
      },
      {
        "name": "Select Model",
        "request": {
          "method": "POST",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": {
            "mode": "raw",
            "raw": "{\n  \"model_id\": \"unsloth/llama-3.1-8b-unsloth-bnb-4bit\",\n  \"output_dir\": \"/app/models/base\",\n  \"quantize\": \"4bit\"\n}"
          },
          "url": {
            "raw": "{{baseUrl}}/select-model",
            "host": ["{{baseUrl}}"],
            "path": ["select-model"]
          },
          "description": "Download and prepare a base model for fine-tuning"
        },
        "response": []
      },
      {
        "name": "Select Model - Llama 3.1 70B",
        "request": {
          "method": "POST",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": {
            "mode": "raw",
            "raw": "{\n  \"model_id\": \"unsloth/llama-3.1-70b-unsloth-bnb-4bit\",\n  \"output_dir\": \"/app/models/base\",\n  \"quantize\": \"4bit\"\n}"
          },
          "url": {
            "raw": "{{baseUrl}}/select-model",
            "host": ["{{baseUrl}}"],
            "path": ["select-model"]
          },
          "description": "Download Llama 3.1 70B model with 4-bit quantization"
        },
        "response": []
      },
      {
        "name": "Select Model - Mistral 7B",
        "request": {
          "method": "POST",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": {
            "mode": "raw",
            "raw": "{\n  \"model_id\": \"unsloth/mistral-7b-unsloth-bnb-4bit\",\n  \"output_dir\": \"/app/models/base\",\n  \"quantize\": \"4bit\"\n}"
          },
          "url": {
            "raw": "{{baseUrl}}/select-model",
            "host": ["{{baseUrl}}"],
            "path": ["select-model"]
          },
          "description": "Download Mistral 7B model with 4-bit quantization"
        },
        "response": []
      },
      {
        "name": "Prepare Data - Instruction Tuning",
        "request": {
          "method": "POST",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": {
            "mode": "raw",
            "raw": "{\n  \"input_file\": \"/app/data/input/dataset.csv\",\n  \"output_dir\": \"/app/data/prepared\",\n  \"task\": \"instruction\",\n  \"augment\": true,\n  \"balance\": false,\n  \"test_size\": 0.2,\n  \"max_length\": 512\n}"
          },
          "url": {
            "raw": "{{baseUrl}}/prepare-data",
            "host": ["{{baseUrl}}"],
            "path": ["prepare-data"]
          },
          "description": "Clean and prepare data for instruction fine-tuning"
        },
        "response": []
      },
      {
        "name": "Prepare Data - Unsupervised",
        "request": {
          "method": "POST",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": {
            "mode": "raw",
            "raw": "{\n  \"input_file\": \"/app/data/input/dataset.csv\",\n  \"output_dir\": \"/app/data/prepared\",\n  \"task\": \"unsupervised\",\n  \"augment\": false,\n  \"balance\": false,\n  \"test_size\": 0.2,\n  \"max_length\": 1024\n}"
          },
          "url": {
            "raw": "{{baseUrl}}/prepare-data",
            "host": ["{{baseUrl}}"],
            "path": ["prepare-data"]
          },
          "description": "Clean and prepare data for unsupervised fine-tuning"
        },
        "response": []
      },
      {
        "name": "Prepare Data - Supervised",
        "request": {
          "method": "POST",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": {
            "mode": "raw",
            "raw": "{\n  \"input_file\": \"/app/data/input/dataset.csv\",\n  \"output_dir\": \"/app/data/prepared\",\n  \"task\": \"supervised\",\n  \"augment\": true,\n  \"balance\": true,\n  \"test_size\": 0.2,\n  \"max_length\": 1024\n}"
          },
          "url": {
            "raw": "{{baseUrl}}/prepare-data",
            "host": ["{{baseUrl}}"],
            "path": ["prepare-data"]
          },
          "description": "Clean and prepare data for supervised fine-tuning with balancing"
        },
        "response": []
      },
      {
        "name": "Fine-tune - Instruction Tuning",
        "request": {
          "method": "POST",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": {
            "mode": "raw",
            "raw": "{\n  \"base_model_dir\": \"/app/models/base\",\n  \"dataset_dir\": \"/app/data/prepared\",\n  \"output_dir\": \"/app/models/finetuned\",\n  \"ft_type\": \"instruction\",\n  \"peft_method\": \"qlora\",\n  \"alignment\": \"none\",\n  \"epochs\": 3,\n  \"batch_size\": 4,\n  \"learning_rate\": 0.0001,\n  \"gradient_accumulation_steps\": 4,\n  \"max_seq_length\": 512\n}"
          },
          "url": {
            "raw": "{{baseUrl}}/fine-tune",
            "host": ["{{baseUrl}}"],
            "path": ["fine-tune"]
          },
          "description": "Start instruction fine-tuning with QLoRA"
        },
        "response": []
      },
      {
        "name": "Fine-tune - SFT",
        "request": {
          "method": "POST",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": {
            "mode": "raw",
            "raw": "{\n  \"base_model_dir\": \"/app/models/base\",\n  \"dataset_dir\": \"/app/data/prepared\",\n  \"output_dir\": \"/app/models/finetuned\",\n  \"ft_type\": \"sft\",\n  \"peft_method\": \"qlora\",\n  \"alignment\": \"none\",\n  \"epochs\": 5,\n  \"batch_size\": 2,\n  \"learning_rate\": 2e-4,\n  \"gradient_accumulation_steps\": 8,\n  \"max_seq_length\": 1024\n}"
          },
          "url": {
            "raw": "{{baseUrl}}/fine-tune",
            "host": ["{{baseUrl}}"],
            "path": ["fine-tune"]
          },
          "description": "Start supervised fine-tuning with QLoRA"
        },
        "response": []
      },
      {
        "name": "Fine-tune - Unsupervised",
        "request": {
          "method": "POST",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": {
            "mode": "raw",
            "raw": "{\n  \"base_model_dir\": \"/app/models/base\",\n  \"dataset_dir\": \"/app/data/prepared\",\n  \"output_dir\": \"/app/models/finetuned\",\n  \"ft_type\": \"unsupervised\",\n  \"peft_method\": \"qlora\",\n  \"alignment\": \"none\",\n  \"epochs\": 2,\n  \"batch_size\": 1,\n  \"learning_rate\": 1e-5,\n  \"gradient_accumulation_steps\": 16,\n  \"max_seq_length\": 2048\n}"
          },
          "url": {
            "raw": "{{baseUrl}}/fine-tune",
            "host": ["{{baseUrl}}"],
            "path": ["fine-tune"]
          },
          "description": "Start unsupervised fine-tuning with larger context"
        },
        "response": []
      },
      {
        "name": "Get Training Status",
        "request": {
          "method": "GET",
          "header": [],
          "url": {
            "raw": "{{baseUrl}}/fine-tune/status/{{taskId}}",
            "host": ["{{baseUrl}}"],
            "path": ["fine-tune", "status", "{{taskId}}"]
          },
          "description": "Get the status of a fine-tuning task using task ID"
        },
        "response": []
      }
    ],
    "variable": [
      {
        "key": "taskId",
        "value": "",
        "type": "string",
        "description": "Task ID returned from fine-tune endpoint"
      }
    ]
  }