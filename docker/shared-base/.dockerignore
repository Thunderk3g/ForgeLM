# Shared Base Docker Ignore
# Only include essential shared components

# Exclude all microservices (base image doesn't need service code)
microservices/

# Exclude entire frontend directory
frontend/

# Exclude service-specific Docker files
docker/api_gateway/
docker/chat_comparison_service/
docker/data_generation_service/
docker/model_management_service/
docker/orchestrator/
docker/training_service/
docker/visualization_service/
# Keep: docker/shared-base/

# Exclude development and testing files
tests/
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Exclude documentation and development files
*.md
docs/
.vscode/
.idea/

# Exclude version control
.git/
.github/

# Exclude logs and data (will be mounted as volumes)
logs/
*.log
data/
datasets/
models/

# Exclude environment files
.env
.env.local
.env.*.local

# Exclude CI/CD and deployment files
kubernetes/
scripts/
.github/
Jenkinsfile
.gitlab-ci.yml

# Exclude temporary and cache files
tmp/
temp/
.DS_Store
Thumbs.db
*.swp
*.swo
__pycache__/
*.py[cod]
*$py.class

# Exclude virtual environment
venv/

# Keep only:
# - utils/ (shared utilities)
# - config/ (shared configuration)
# - docker/shared-base/ (this base image files)