# Visualization Service Docker Ignore - Microservice Specific
# This file reduces build context by excluding files not needed for Visualization Service

# Exclude other microservices (only need visualization_service + shared dependencies)
microservices/api_gateway/
microservices/chat_comparison_service/
microservices/data_generation_service/
microservices/model_management_service/
microservices/orchestrator/
microservices/training_service/
# Keep: microservices/visualization_service/

# Exclude entire frontend directory (React app not needed in backend)
frontend/


# Exclude large cache and compiled directories
venv/
__pycache__/
*.py[cod]
*$py.class

# Exclude development and testing files
tests/
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Exclude documentation and development files
*.md
docs/
.vscode/
.idea/

# Exclude version control
.git/
.github/

# Exclude logs (these are mounted as volumes)
logs/
*.log

# Exclude environment files
.env
.env.local
.env.*.local

# Exclude Docker files from other services
docker/api_gateway/
docker/chat_comparison_service/
docker/data_generation_service/
docker/model_management_service/
docker/orchestrator/
docker/training_service/
# Keep: docker/visualization_service/

# Exclude CI/CD and deployment files
kubernetes/
scripts/
.github/
Jenkinsfile
.gitlab-ci.yml

# Exclude temporary and cache files
tmp/
temp/
.DS_Store
Thumbs.db
*.swp
*.swo

# Exclude Node.js files (if any accidentally present)
node_modules/
package-lock.json
yarn.lock

# Keep data/ directory for analytics and visualization data
# Keep models/ for metadata visualization
# Keep configs/ for visualization configurations