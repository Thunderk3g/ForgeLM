# LLMForge Microservices Environment Configuration
# Copy this to .env and customize for your setup

# ============================================================================
# GPU CONFIGURATION
# ============================================================================
CUDA_VISIBLE_DEVICES=0
MAX_HBM_GB=12

# ============================================================================
# TRAINING CONFIGURATION
# ============================================================================
# Hugging Face access token for gated models. The Hugging Face libraries read HF_TOKEN;
# HUGGINGFACE_TOKEN is still accepted by docker-compose as a fallback for older .env files.
HF_TOKEN=your_hf_token_here

# Training service: also hold the Redis-backed cross-service GPU lock while a fine-tuning job runs (true/false; jobs queue one at a time either way)
TRAINING_USE_GPU_LOCK=false

# API gateway: timeout for synchronous factory classifier training (seconds); other requests use 30 s
GATEWAY_LONG_REQUEST_TIMEOUT_S=1800

# ============================================================================
# FACTORY SERVICE (CPU only: planning, LLM-free classifiers, BFSI screening)
# ============================================================================
# The defaults below are the values the service uses when a variable is unset.
# docker-compose.yml hands a variable from this file to a container only where its
# environment list names it as ${VAR}; check that the factory-service entry does.
# Directory inside the container where trained classifiers are written (a volume in compose and Kubernetes)
FACTORY_MODELS_DIR=/app/models/factory
# Comma-separated Hugging Face repo ids a training request may name as "model"; any other value is refused
FACTORY_ALLOWED_MODELS=minishlab/potion-base-32M,minishlab/potion-base-8M,BAAI/bge-small-en-v1.5,sentence-transformers/all-MiniLM-L6-v2,intfloat/multilingual-e5-small,answerdotai/ModernBERT-base
# Most rows (texts) accepted by one training request
FACTORY_MAX_TRAIN_ROWS=50000
# Most texts (or utterances) accepted by one predict or review-call request
FACTORY_MAX_PREDICT_ROWS=10000
# Longest single text, in characters, accepted on predict and review-call
FACTORY_MAX_TEXT_CHARS=20000
